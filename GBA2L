        /**
         * Properly encodes a UTF-8 string into Base64 for GitHub's Contents API.
         */
        function utf8ToBase64(str) {
            const bytes = new TextEncoder().encode(str);
            let binString = '';
            for (let i = 0; i < bytes.byteLength; i++) {
                binString += String.fromCharCode(bytes[i]);
            }
            return btoa(binString);
        }

        /**
         * Displays an inline status banner at the top of the card.
         */
        function showBanner(message, type = 'info') {
            const banner = document.getElementById('statusBanner');
            banner.classList.remove('hidden', 'bg-red-50', 'text-red-800', 'border-red-200', 'bg-emerald-50', 'text-emerald-800', 'border-emerald-200', 'bg-blue-50', 'text-blue-800', 'border-blue-200');
            
            if (type === 'error') {
                banner.classList.add('bg-red-50', 'text-red-800', 'border-red-200');
            } else if (type === 'success') {
                banner.classList.add('bg-emerald-50', 'text-emerald-800', 'border-emerald-200');
            } else {
                banner.classList.add('bg-blue-50', 'text-blue-800', 'border-blue-200');
            }
            
            banner.textContent = message;
        }

        /**
         * Appends a timestamped line to the execution log.
         */
        function appendLog(message, status = 'info') {
            const logContainer = document.getElementById('logContainer');
            const logBox = document.getElementById('executionLog');
            logContainer.classList.remove('hidden');

            const line = document.createElement('div');
            const time = new Date().toLocaleTimeString();
            
            if (status === 'success') line.className = 'text-emerald-400';
            else if (status === 'error') line.className = 'text-rose-400';
            else if (status === 'warn') line.className = 'text-amber-300';
            else line.className = 'text-slate-300';

            line.textContent = `[${time}] ${message}`;
            logBox.appendChild(line);
            logBox.scrollTop = logBox.scrollHeight;
        }

        /**
         * Fetches the official Apache 2.0 license text from GitHub's License API (with fallback).
         */
        async function loadOfficialApacheLicense(token) {
            if (officialApacheText) return officialApacheText;
            try {
                const res = await fetch('https://api.github.com/licenses/apache-2.0', {
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Accept': 'application/vnd.github+json',
                        'X-GitHub-Api-Version': '2022-11-28'
                    }
                });
                if (res.ok) {
                    const data = await res.json();
                    if (data.body) {
                        officialApacheText = data.body;
                        return officialApacheText;
                    }
                }
            } catch (e) {
                // Fall back silently
            }
            officialApacheText = FALLBACK_APACHE_2_TEXT;
            return officialApacheText;
        }

        /**
         * Fetches owned repositories based on the selected visibility filter.
         */
        async function fetchRepositories() {
            const token = document.getElementById('patInput').value.trim();
            const visibility = document.getElementById('visibilityFilter').value;

            if (!token) {
                showBanner('Please enter your GitHub Personal Access Token first.', 'error');
                return;
            }

            const fetchBtn = document.getElementById('fetchBtn');
            fetchBtn.disabled = true;
            fetchBtn.innerHTML = '<span>Fetching...</span>';
            showBanner('Connecting to GitHub API and loading repositories...', 'info');

            fetchedRepos = [];
            let page = 1;
            let hasMore = true;

            try {
                // Pre-load Apache 2.0 text and user profile for default copyright name
                await loadOfficialApacheLicense(token);
                const copyrightInput = document.getElementById('copyrightOwner');
                if (!copyrightInput.value.trim()) {
                    const userRes = await fetch('https://api.github.com/user', {
                        headers: {
                            'Authorization': `Bearer ${token}`,
                            'Accept': 'application/vnd.github+json'
                        }
                    });
                    if (userRes.ok) {
                        const userData = await userRes.json();
                        const year = new Date().getFullYear();
                        copyrightInput.value = `${year} ${userData.name || userData.login}`;
                    }
                }

                while (hasMore) {
                    const response = await fetch(`https://api.github.com/user/repos?visibility=${visibility}&affiliation=owner&per_page=100&page=${page}`, {
                        headers: {
                            'Authorization': `Bearer ${token}`,
                            'Accept': 'application/vnd.github+json',
                            'X-GitHub-Api-Version': '2022-11-28'
                        }
                    });

                    if (!response.ok) {
                        const errData = await response.json().catch(() => ({}));
                        throw new Error(errData.message || `HTTP Error ${response.status}`);
                    }

                    const data = await response.json();
                    fetchedRepos = fetchedRepos.concat(data);

                    if (data.length < 100) {
                        hasMore = false;
                    } else {
                        page++;
                    }
                }

                renderRepoList();
                if (fetchedRepos.length === 0) {
                    showBanner('No repositories found matching your filter.', 'success');
                } else {
                    showBanner(`Successfully loaded ${fetchedRepos.length} repository(s).`, 'success');
                }
            } catch (error) {
                showBanner(`Failed to fetch repositories: ${error.message}`, 'error');
            } finally {
                fetchBtn.disabled = false;
                fetchBtn.innerHTML = '<span>Fetch Repositories</span>';
            }
        }

        /**
         * Renders the list of repositories along with their current detected license.
         */
        function renderRepoList() {
            const repoSection = document.getElementById('repoSection');
            const repoList = document.getElementById('repoList');
            const repoCount = document.getElementById('repoCount');

            repoCount.textContent = fetchedRepos.length;
            repoList.innerHTML = '';

            if (fetchedRepos.length === 0) {
                repoSection.classList.add('hidden');
                return;
            }

            repoSection.classList.remove('hidden');

            fetchedRepos.forEach((repo) => {
                const licenseKey = repo.license ? repo.license.key : 'none';
                const licenseName = repo.license ? repo.license.spdx_id || repo.license.name : 'No License';
                const isAlreadyApache = licenseKey === 'apache-2.0';

                const badgeClass = isAlreadyApache 
                    ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' 
                    : (licenseKey === 'none' ? 'bg-amber-50 text-amber-700 border border-amber-200' : 'bg-slate-100 text-slate-700');

                const label = document.createElement('label');
                label.className = 'flex items-center justify-between p-3 rounded-xl hover:bg-slate-50 cursor-pointer transition-colors';
                
                label.innerHTML = `
                    <div class="flex items-center gap-3 overflow-hidden">
                        <input 
                            type="checkbox" 
                            ${!isAlreadyApache ? 'checked' : ''} 
                            data-apache="${isAlreadyApache}"
                            data-branch="${repo.default_branch}"
                            value="${repo.full_name}" 
                            class="repo-checkbox w-4 h-4 rounded text-indigo-600 focus:ring-indigo-600 border-slate-300" 
                            onchange="updateSelectedButtonState()"
                        >
                        <div class="truncate">
                            <div class="flex items-center gap-2">
                                <p class="text-sm font-semibold text-slate-800 truncate">${repo.name}</p>
                                <span class="text-[10px] uppercase tracking-wider font-semibold px-1.5 py-0.5 rounded bg-slate-100 text-slate-500">
                                    ${repo.private ? 'Private' : 'Public'}
                                </span>
                            </div>
                            <p class="text-xs text-slate-500 truncate">${repo.description || 'No description'}</p>
                        </div>
                    </div>
                    <span class="text-xs font-medium px-2.5 py-1 rounded-full shrink-0 ml-2 ${badgeClass}">
                        ${licenseName}
                    </span>
                `;
                repoList.appendChild(label);
            });

            updateSelectedButtonState();
        }

        /**
         * Selects only repositories that do not currently have Apache 2.0.
         */
        function selectNonApache() {
            const checkboxes = document.querySelectorAll('.repo-checkbox');
            checkboxes.forEach(cb => {
                cb.checked = cb.dataset.apache !== 'true';
            });
            updateSelectedButtonState();
        }

        /**
         * Toggles all repository checkboxes.
         */
        function toggleSelectAll() {
            const checkboxes = document.querySelectorAll('.repo-checkbox');
            const anyUnchecked = Array.from(checkboxes).some(cb => !cb.checked);
            checkboxes.forEach(cb => cb.checked = anyUnchecked);
            updateSelectedButtonState();
        }

        /**
         * Updates the action button state based on how many checkboxes are ticked.
         */
        function updateSelectedButtonState() {
            const checkedCount = document.querySelectorAll('.repo-checkbox:checked').length;
            const btn = document.getElementById('openConfirmBtn');
            btn.disabled = checkedCount === 0;
            btn.textContent = checkedCount > 0 ? `Apply Apache 2.0 (${checkedCount})` : 'Apply Apache 2.0 License';
        }

        function openConfirmModal() {
            const checkedCount = document.querySelectorAll('.repo-checkbox:checked').length;
            if (checkedCount === 0) return;
            document.getElementById('selectedCountModal').textContent = checkedCount;
            document.getElementById('confirmModal').classList.remove('hidden');
        }

        function closeConfirmModal() {
            document.getElementById('confirmModal').classList.add('hidden');
        }

        /**
         * Checks if a LICENSE (or LICENSE.md / LICENSE.txt) file already exists in the repo root to retrieve its SHA.
         */
        async function findExistingLicenseFile(fullName, branch, token) {
            const candidatePaths = ['LICENSE', 'LICENSE.md', 'LICENSE.txt', 'license', 'license.md'];
            for (const path of candidatePaths) {
                try {
                    const res = await fetch(`https://api.github.com/repos/${fullName}/contents/${path}?ref=${encodeURIComponent(branch)}`, {
                        headers: {
                            'Authorization': `Bearer ${token}`,
                            'Accept': 'application/vnd.github+json',
                            'X-GitHub-Api-Version': '2022-11-28'
                        }
                    });
                    if (res.ok) {
                        const fileData = await res.json();
                        return { path: fileData.path, sha: fileData.sha };
                    }
                } catch (e) {
                    // Continue checking candidates
                }
            }
            return null;
        }

        /**
         * Commits the Apache 2.0 LICENSE file to each selected repository.
         */
        async function executeBulkLicenseUpdate() {
            closeConfirmModal();
            const token = document.getElementById('patInput').value.trim();
            const copyrightOwner = document.getElementById('copyrightOwner').value.trim();
            const selectedCheckboxes = Array.from(document.querySelectorAll('.repo-checkbox:checked'));
            
            if (!token || selectedCheckboxes.length === 0) return;

            const openConfirmBtn = document.getElementById('openConfirmBtn');
            openConfirmBtn.disabled = true;
            document.getElementById('executionLog').innerHTML = '';

            // Prepare license content
            let licenseContent = await loadOfficialApacheLicense(token);
            if (copyrightOwner) {
                licenseContent = licenseContent.replace(
                    'Copyright [yyyy] [name of copyright owner]',
                    `Copyright ${copyrightOwner}`
                );
            }
            const encodedContent = utf8ToBase64(licenseContent);

            showBanner(`Applying Apache License 2.0 to ${selectedCheckboxes.length} repository(s)...`, 'info');
            appendLog(`Starting bulk Apache 2.0 license update for ${selectedCheckboxes.length} repositories...`);

            let successCount = 0;
            let failCount = 0;

            for (const checkbox of selectedCheckboxes) {
                const fullName = checkbox.value;
                const branch = checkbox.dataset.branch || 'main';

                try {
                    // Check for existing license file to get its SHA if updating
                    const existing = await findExistingLicenseFile(fullName, branch, token);
                    const targetPath = existing ? existing.path : 'LICENSE';

                    const payload = {
                        message: existing ? 'Update LICENSE to Apache License 2.0' : 'Add Apache License 2.0',
                        content: encodedContent,
                        branch: branch
                    };

                    if (existing && existing.sha) {
                        payload.sha = existing.sha;
                    }

                    const putRes = await fetch(`https://api.github.com/repos/${fullName}/contents/${targetPath}`, {
                        method: 'PUT',
                        headers: {
                            'Authorization': `Bearer ${token}`,
                            'Accept': 'application/vnd.github+json',
                            'Content-Type': 'application/json',
                            'X-GitHub-Api-Version': '2022-11-28'
                        },
                        body: JSON.stringify(payload)
                    });

                    if (!putRes.ok) {
                        const errData = await putRes.json().catch(() => ({}));
                        throw new Error(errData.message || `HTTP ${putRes.status}`);
                    }

                    successCount++;
                    appendLog(`SUCCESS: ${fullName} (${existing ? 'updated ' + targetPath : 'created LICENSE'})`, 'success');
                } catch (err) {
                    failCount++;
                    appendLog(`ERROR (${fullName}): ${err.message}`, 'error');
                }
            }

            appendLog(`Finished! Updated: ${successCount}, Failed: ${failCount}.`);
            
            if (failCount === 0) {
                showBanner(`Apache License 2.0 applied to all ${successCount} selected repositories!`, 'success');
            } else {
                showBanner(`Completed with ${successCount} succeeded and ${failCount} failed. Check the log below for details.`, 'error');
            }

            // Refresh list to show updated license badges (Note: GitHub may take a few seconds to re-index license metadata)
            setTimeout(() => fetchRepositories(), 1500);
        }
    </script>
</body>
